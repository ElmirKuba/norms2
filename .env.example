# Пример переменных окружения «Нормисов». Скопировать в .env и заполнить.
# .env в git НЕ коммитится. В коде читаются только через ConfigService (zod,
# fail-fast) — никогда process.env напрямую (CLAUDE.md, ADR-0019).
# Полные описания — docs/backend.md и docs/deployment.md.
# Без inline-комментариев в строках VAR=value: файл подхватывает и Makefile
# (include .env), а Make трактует # как комментарий в любом месте строки.

NODE_ENV=development

# ── PostgreSQL ──
# DB_HOST=localhost — для бэка/тулинга на хосте (postgres опубликован на localhost).
# В Docker сам nest-контейнер переопределяет DB_HOST на имя контейнера БД (compose).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=norms2
DB_USER=norms2
# Dev-значение; в проде — секрет вне репозитория.
DB_PASSWORD=norms2

# ── pgAdmin (только dev) ──
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=8081

# ── Порты приложений ──
BACKEND_PORT=3000
FRONTEND_PORT=4200
# CORS-origin фронта (dev, кросс-порт). В проде пусто (same-origin за Traefik).
CORS_ORIGIN=http://localhost:4200

# ── Авторизация / JWT (заполнить своим секретом!) ──
# ≥32 символов из CSPRNG, напр.: openssl rand -base64 36
JWT_ACCESS_SECRET=change-me-to-a-32-plus-char-random-secret
ACCESS_TTL=15m
REFRESH_TTL=30d
# true в проде (refresh-cookie только по HTTPS).
COOKIE_SECURE=false

# ── Бизнес-флаги фазы 1 ──
# dev: открытая рега; прод — false (invite-only).
FREE_REGISTRATION=true
INVITE_DEFAULT_QUOTA=0
INVITE_TTL_DAYS=3
AVATAR_MAX_BYTES=512000
# Попыток optimistic-lock retry на правках профиля (ADR-0035).
OPTIMISTIC_RETRY_ATTEMPTS=3

# ── Тюнеры раздела «Акцент» (опц.; есть дефолты в коде, env-схема) ──
# Макс. глубина дерева целей (ADR-0052; дефолт 2 = 1 уровень подцелей):
# ACCENT_GOAL_MAX_DEPTH=2
# Мягкий порог «в фокусе» целей (ADR-0053; дефолт 3; сверх — вопрос, не блок):
# ACCENT_GOAL_FOCUS_SOFT_LIMIT=3
# Окно (дней) для adherence maintain-целей «удерживать уровень» (ADR-0052; дефолт 30):
# ACCENT_GOAL_MAINTAIN_WINDOW_DAYS=30
# Мягкий порог активных препятствий (ADR-0062, 2.7; дефолт 7; сверх — подсказка, не блок):
# ACCENT_OBSTACLE_SOFT_LIMIT=7

# ── Роли и админка (2.9.3) ──
# Логины администраторов через запятую, напр.: ADMIN_LOGINS=elmir_kuba
# Пусто по умолчанию — случайных админов не бывает. Аккаунта может ещё не быть:
# тогда сид скажет в лог и попробует на следующем старте.
# Роли только ВЫДАЮТСЯ: убрали логин отсюда — права остаются. Снятие роли это
# осознанное действие админки, а не побочный эффект правки переменной.
ADMIN_LOGINS=

# ── Telegram: бот-приёмная и канал-витрина (2.9.1, ADR-0064) ──
# Пустой токен — РАБОЧИЙ режим по умолчанию, а не «не настроено»: наружу не уходит
# ничего, продукт живёт как жил. Заполнять только там, где бот реально нужен.
TELEGRAM_BOT_TOKEN=
# Пауза бота (2.9.3) — ОТДЕЛЬНО от токена. true: бот не отвечает, не постит в канал
# и не публикует меню команд, а входящие апдейты принимаются и роняются. Секрет при
# этом остаётся на месте — вернуть бота = снять флаг, а не искать токен заново.
# Цена паузы: написанное боту в это время теряется.
TELEGRAM_BOT_PAUSED=false
# Канал-витрина. На dev — ТЕСТОВЫЙ канал: боевой здесь означал бы, что отладочные
# посты увидят подписчики, а увиденное не удаляется вместе с постом.
TELEGRAM_CHANNEL_ID=
# Чат владельца — единственный, чьи команды бот исполняет. Уезжает в 2.9.3·3а:
# права переходят к роли admin у привязанного аккаунта.
TELEGRAM_OWNER_CHAT_ID=
# Юзернейм бота для строки «нет приглашения? заявка боту» в посте; пусто — строки нет.
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_URL=
TELEGRAM_BOT_URL=
# Секрет вебхука: задаётся при setWebhook и сверяется на каждом апдейте. ПУСТОЙ =
# ручки нет (404), а не «принимаем всех»: открытый вебхук у бота, умеющего выдавать
# приглашения, — это раздача приглашений кому угодно.
TELEGRAM_WEBHOOK_SECRET=

# ── Версия (ADR-0044) ──
# Версия продукта «Нормисы» — в файле VERSION в корне репо (единый source of truth);
# бэк читает его и отдаёт в GET /version. В .env версии нет.
# GIT_COMMIT здесь НЕ задаём: dev читает .git живьём, прод — build ARG. Пустой
# GIT_COMMIT в .env перебил бы оба → не добавлять.

# ── Прод (docker-compose.prod.yml, Traefik + Let's Encrypt) ──
# Раскомментировать и заполнить при настройке VPS.
# DOMAIN=нормисы.рф
# ACME_EMAIL=admin@example.com
